# Whitelist the app build inputs. Keys, local configs, drivers, evidence,
# decompilation exports and private SSH material never enter the build context.
**
!Dockerfile
!pyproject.toml
!gamebond/
!gamebond/*.py
!gamebond/admin/
!gamebond/admin/*.py
!gamebond/admin/static/
!gamebond/admin/static/*
!tools/
!tools/container-entrypoint.sh
