diff --git a/netlib/src/iphelper/gamebond_process_birth.h b/netlib/src/iphelper/gamebond_process_birth.h
new file mode 100644
index 0000000..fe1840c
--- /dev/null
+++ b/netlib/src/iphelper/gamebond_process_birth.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <Windows.h>
+#include <algorithm>
+#include <cstddef>
+#include <cstring>
+#include <vector>
+
+namespace iphelper {
+// Protected service processes can deny OpenProcess even though the system
+// process snapshot exposes their creation time. Keep the native PID generation
+// binding; the authenticated consumer independently verifies birth and image.
+inline unsigned long long gamebond_snapshot_birth(const DWORD pid) {
+    using query_t = LONG (WINAPI*)(ULONG, PVOID, ULONG, PULONG);
+    const auto module = ::GetModuleHandleW(L"ntdll.dll");
+    const auto query = module ? reinterpret_cast<query_t>(::GetProcAddress(module, "NtQuerySystemInformation")) : nullptr;
+    if (!query || !pid) return 0;
+    struct process_prefix {
+        ULONG next;
+        ULONG threads;
+        BYTE reserved[24];
+        LARGE_INTEGER created, user, kernel;
+        struct { USHORT length, maximum; PWSTR buffer; } image;
+        LONG priority;
+        HANDLE id;
+    };
+    static_assert(sizeof(void*) == 8, "GameBond capture extension requires x64");
+    static_assert(offsetof(process_prefix, created) == 32);
+    static_assert(offsetof(process_prefix, id) == 80);
+    constexpr ULONG maximum = 16 * 1024 * 1024;
+    std::vector<BYTE> buffer(128 * 1024);
+    for (;;) {
+        ULONG required = 0;
+        const LONG status = query(5, buffer.data(), static_cast<ULONG>(buffer.size()), &required);
+        if (status == static_cast<LONG>(0xC0000004UL)) {
+            const size_t size = (std::max)(buffer.size() * 2, static_cast<size_t>(required));
+            if (size > maximum) return 0;
+            buffer.resize(size);
+            continue;
+        }
+        if (status < 0 || required > buffer.size() || required < sizeof(process_prefix)) return 0;
+        size_t offset = 0;
+        while (offset <= required - sizeof(process_prefix)) {
+            process_prefix row{};
+            std::memcpy(&row, buffer.data() + offset, sizeof(row));
+            if (reinterpret_cast<ULONG_PTR>(row.id) == pid)
+                return row.created.QuadPart > 116444736000000000LL ? row.created.QuadPart : 0;
+            if (row.next < sizeof(row) || row.next > required - offset) return 0;
+            offset += row.next;
+        }
+        return 0;
+    }
+}
+}
