+            // Preserve birth time with the actual owner lookup, not a later PID query.
+            if (resolved && id) {
+                const HANDLE handle = ::OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, id);
+                if (handle) {
+                    FILETIME birth{}, exit{}, kernel{}, user{};
+                    wchar_t image[32768]{}; DWORD length = 32768;
+                    // Service-tag resolution returns a service name, not an image
+                    // path. Bind that owner to its host PID's lifetime; Python
+                    // resolves and authorizes the host executable independently.
+                    const bool service_owner = this->path_name.find_first_of(L"\\/:") == std::wstring::npos;
+                    if (::GetProcessTimes(handle, &birth, &exit, &kernel, &user) &&
+                        ::QueryFullProcessImageNameW(handle, 0, image, &length) &&
+                        (service_owner || _wcsicmp(image, this->path_name.c_str()) == 0)) {
+                        creation_filetime = (static_cast<unsigned long long>(birth.dwHighDateTime) << 32) | birth.dwLowDateTime;
+                    }
+                    ::CloseHandle(handle);
+                }
+                else {
+                    creation_filetime = gamebond_snapshot_birth(id);
+                }
+            }
         }
 
